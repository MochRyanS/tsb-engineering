rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* KOLEKSI UTAMA 'workorders' (huruf kecil semua) — berisi WO lama
       (WO-2026-0000x) dan semua WO baru:
       - baca  : publik → dashboard & halaman /tracking
       - buat  : publik → form work order di website utama
       - ubah  : publik → dashboard admin (status/PIC/foto)
       - hapus : ditolak → data WO tidak boleh dihapus dari klien */
    match /workorders/{woId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    /* KOLEKSI WARISAN 'workOrders' (camelCase) — dibuat oleh update
       sebelumnya. Tetap terbuka supaya WO di dalamnya bisa dibaca &
       otomatis dipindahkan ke koleksi utama oleh service. */
    match /workOrders/{woId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }
  }
}
